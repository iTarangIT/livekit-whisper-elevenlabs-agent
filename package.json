{
  "name": "elevenlabs-whisper-voice-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time voice agent: LiveKit + OpenAI Realtime (voice-to-voice)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts dev",
    "start": "node dist/index.js start",
    "trunk:setup": "tsx src/bin/setup-trunk.ts",
    "call": "tsx src/bin/call.ts",
    "metrics:report": "tsx src/bin/metrics-report.ts"
  },
  "dependencies": {
    "@livekit/agents": "^1.4.5",
    "@livekit/agents-plugin-openai": "^1.4.5",
    "@livekit/protocol": "^1.46.6",
    "@livekit/rtc-node": "^0.13.29",
    "livekit-server-sdk": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
